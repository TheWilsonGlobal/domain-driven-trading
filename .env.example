# Placeholder names only. Copy to .env and fill in real values locally.
PORT=5470
WEB_PORT=5471
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=
KAFKA_BROKERS=
# REDIS_ADDR: host:port, or a redis:// / rediss:// URL (Render Key Value's connectionString).
REDIS_ADDR=
SUPABASE_DB_PASSWORD=

# --- Authentication (/v1 requires "Authorization: Bearer <jwt>") ---
# AUTH_MODE: jwt (default) | disabled-for-local-dev. Unknown values stop startup.
# disabled-for-local-dev logs a loud warning and reads the account id from the
# X-Dev-Account-Id request header. Never use it outside local development.
# It ALSO requires ALLOW_INSECURE_DEV_AUTH=1 and an EMPTY JWKS_URL (startup
# fails otherwise), and the gateway then listens on 127.0.0.1 only.
AUTH_MODE=jwt
# Second switch for AUTH_MODE=disabled-for-local-dev; any other value fails startup.
# ALLOW_INSECURE_DEV_AUTH=1
# Required when AUTH_MODE=jwt (startup fails if any is empty). Must be https
# unless the host is loopback (localhost, 127.0.0.1, ::1); redirects to non-https
# URLs are refused.
JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
# Token claim holding the trading account id (dotted path allowed, e.g.
# app_metadata.account_id). Default account_id; there is no fallback to "sub".
AUTH_ACCOUNT_CLAIM=account_id

# --- Account seeding (explicit step at startup; creates missing accounts only) ---
# Format: ID:cash[:SYM=qty,SYM=qty][;ID:cash...]   (cash in VND)
# Unset = defaults ACC_APX_001, ACC_APX_002, ACC_INST_MM, FEE_COLLECTOR.
# FEE_COLLECTOR is always ensured. Existing accounts are never overwritten.
SEED_ACCOUNTS=

# --- Event bus (gateway publishes + feeds /ws/market; settlement worker consumes) ---
# KAFKA_BROKERS: comma list host:port (Kafka / Redpanda). BUS=memory is the ONLY
# way to run without a broker (logged at WARN; events stay in-process, so the
# settlement worker receives nothing). Neither set = startup error. An
# unreachable broker = startup error.
BUS=
# Optional security, all off by default (local compose has neither).
# SASL/PLAIN: set BOTH user and password; use together with KAFKA_TLS=true on any
# network you do not fully control. The password is never logged.
KAFKA_SASL_USER=
KAFKA_SASL_PASSWORD=
KAFKA_TLS=false

# --- Idempotency store (POST /v1/orders) ---
# Key per request: X-Idempotency-Key header or body client_order_id (required;
# 400 when both are missing). Stored as idem:{account}:{key} in Redis from
# REDIS_ADDR (+ REDIS_PASSWORD). IDEMPOTENCY=memory is the only way to run
# without Redis (bounded, process-local, WARN). Redis down at runtime = 503.
IDEMPOTENCY=

# --- HTTP hardening (phase 7) ---
# CORS and /ws/market share one exact-match Origin allowlist (comma list, no
# wildcard, no paths). Unset = http://localhost:<WEB_PORT> and
# http://127.0.0.1:<WEB_PORT> (WEB_PORT defaults to 5471). Credentials are off.
CORS_ALLOWED_ORIGINS=
# Per-client-IP limits per second on /v1 (429 + Retry-After when exceeded;
# /health is exempt). Writes = POST/PUT/PATCH/DELETE. Raise them for load tests.
RATE_LIMIT_RPS=100
RATE_LIMIT_WRITE_RPS=50
# k6 benchmark (scripts/k6_benchmark.js): one source IP, so start the gateway with
# RATE_LIMIT_RPS=1000000 RATE_LIMIT_WRITE_RPS=1000000, AUTH_MODE=disabled-for-local-dev
# ALLOW_INSECURE_DEV_AUTH=1 (JWKS_URL empty; binds 127.0.0.1 only)
# and SEED_ACCOUNTS=$(scripts/gen-seed-accounts.ps1 -Count 500); run k6 with DEV_AUTH=1 ACCOUNTS=500.
# true ONLY behind a reverse proxy you operate that overwrites X-Forwarded-For /
# X-Real-IP; otherwise clients could spoof their IP and dodge the limiter.
TRUSTED_PROXY=false
# Maximum concurrent /ws/market clients (over it: 503).
WS_MAX_CLIENTS=1000
