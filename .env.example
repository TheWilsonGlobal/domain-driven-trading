# ==============================================================================
# Domain-Driven Trading Engine - Configuration
# ==============================================================================

# HTTP & WebSocket API Gateway Port
PORT=5470

# Web Trading Terminal (Vite) Port
WEB_PORT=5471

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Mode A: Standalone Docker Compose (deployments/docker-compose.yml)
# ------------------------------------------------------------------------------
# KAFKA_BROKERS=redpanda:9092
# REDIS_ADDR=redis:6379
# DATABASE_URL=postgres://ddt_user:ddt_secret_password@postgres:5432/domain_driven_trading?sslmode=disable

# ------------------------------------------------------------------------------
# Mode B: Connected to External / Existing Infrastructure Services
# Run via: `make docker-up SERVICES_ONLY=true` or `make docker-up-services`
# ------------------------------------------------------------------------------
KAFKA_BROKERS=host.docker.internal:9100
REDIS_ADDR=host.docker.internal:6379
DATABASE_URL=postgres://postgres:password@host.docker.internal:5432/domain_driven_trading?sslmode=disable

# ------------------------------------------------------------------------------
# Local Host Running (e.g. `make run-engine`, `make run-gateway`)
# ------------------------------------------------------------------------------
# KAFKA_BROKERS=localhost:9100
# REDIS_ADDR=localhost:6379
# DATABASE_URL=postgres://postgres:password@localhost:5432/domain_driven_trading?sslmode=disable
