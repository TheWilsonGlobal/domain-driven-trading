# ==============================================================================
# Domain-Driven Trading Engine - Configuration
# ==============================================================================

# HTTP & WebSocket API Gateway Port
PORT=5470

# Web Trading Terminal (Vite) Port
WEB_PORT=5471

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Message Broker & Idempotency Store
KAFKA_BROKERS=host.docker.internal:9100
REDIS_ADDR=host.docker.internal:6379

# ==============================================================================
# Supabase Production & Settlement Configuration
# ==============================================================================

# Supabase REST / PostgREST & Auth
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Supabase Transaction Pooler (PgBouncer IPv4 Port 6543)
DATABASE_URL=postgres://postgres.<project-ref>:<percent-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Direct Session Connection (For Migration / Schema DDL / One-off ETL)
DIRECT_URL=postgres://postgres:<percent-encoded-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Session Pooler (IPv4 Port 5432)
SESSION_POOLER_URL=postgres://postgres.<project-ref>:<percent-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Alternative Database Configurations (Local Fallbacks)
# ------------------------------------------------------------------------------
# Mode A: Standalone Docker Compose (deployments/docker-compose.yml)
# DATABASE_URL=postgres://ddt_user:ddt_secret_password@postgres:5432/domain_driven_trading?sslmode=disable
# KAFKA_BROKERS=redpanda:9092
# REDIS_ADDR=redis:6379

# Mode B: Connected to Local Hub PostgreSQL (host.docker.internal:5432)
# DATABASE_URL=postgres://postgres:password@host.docker.internal:5432/domain_driven_trading?sslmode=disable

# Mode C: Direct Local Host Running (localhost:5432)
# DATABASE_URL=postgres://postgres:password@localhost:5432/domain_driven_trading?sslmode=disable
# KAFKA_BROKERS=localhost:9100
# REDIS_ADDR=localhost:6379
