# Copy to .env and fill in. Placeholders only in this file.
# Set a variable only to override its default. Defaults live in code:
# ports 5470/5471, RATE_LIMIT_RPS=100, RATE_LIMIT_WRITE_RPS=50, WS_MAX_CLIENTS=1000,
# AUTH_MODE=jwt, AUTH_ACCOUNT_CLAIM=account_id (internal/config, internal/infrastructure).
# STORE, IDEMPOTENCY and BUS follow from DATABASE_URL, REDIS_ADDR and KAFKA_BROKERS.

# --- PostgreSQL ---
# DATABASE_URL is required. STORE=memory is the only way to run without it
# (accounts, orders and trades are then lost on restart).
DATABASE_URL=
SUPABASE_DB_PASSWORD=
# Used by deployments/docker-compose.yml only.
POSTGRES_PASSWORD=

# --- Event bus (the gateway publishes and feeds /ws/market; settlement consumes) ---
# KAFKA_BROKERS: comma list of host:port. BUS=memory is the only way to run without a
# broker (events stay in-process, so settlement receives nothing).
KAFKA_BROKERS=
# Optional, off by default. SASL/PLAIN needs BOTH user and password. Use it with
# KAFKA_TLS=true on any network you do not fully control. The password is never logged.
KAFKA_SASL_USER=
KAFKA_SASL_PASSWORD=
KAFKA_TLS=false

# --- Idempotency store (POST /v1/orders) ---
# Keys come from the X-Idempotency-Key header or client_order_id in the body (400 when
# both are missing). REDIS_ADDR is host:port or a redis:// / rediss:// URL.
# IDEMPOTENCY=memory is the only way to run without Redis (bounded, lost on restart).
REDIS_ADDR=
REDIS_PASSWORD=

# --- Authentication (/v1 requires "Authorization: Bearer <jwt>") ---
# Required in jwt mode. JWKS_URL must be https unless its host is loopback.
JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
# Local development only. AUTH_MODE=disabled-for-local-dev trusts the X-Dev-Account-Id
# header. It also needs ALLOW_INSECURE_DEV_AUTH=1 and an empty JWKS_URL, and the gateway
# then listens on 127.0.0.1 only.
# AUTH_MODE=disabled-for-local-dev
# ALLOW_INSECURE_DEV_AUTH=1

# --- Accounts ---
# Created at startup when missing; existing accounts are never overwritten.
# Format: ID:cash[:SYM=qty,SYM=qty][;ID:cash...] (cash in VND). Unset = local defaults.
SEED_ACCOUNTS=

# --- HTTP ---
# Exact-match origins for CORS and /ws/market. Unset = http://localhost:WEB_PORT.
CORS_ALLOWED_ORIGINS=
# WEB_PORT=5471
# PORT=5470
# Per-client-IP limits per second on /v1 (429 when exceeded; /health is exempt).
# RATE_LIMIT_RPS=100
# RATE_LIMIT_WRITE_RPS=50
# Set true ONLY behind a reverse proxy you operate that overwrites X-Forwarded-For /
# X-Real-IP. Otherwise clients can spoof their IP and dodge the limiter.
TRUSTED_PROXY=false
# WS_MAX_CLIENTS=1000

# k6 benchmark: read the header of scripts/k6_benchmark.js first.
